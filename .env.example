# 안심코드 환경 변수. `cp .env.example .env` 후 값을 채운다.
# .env는 git 미추적이다 — 키를 코드·문서·로그에 넣지 않는다.

# Google Gemini API 키. 비워 두면 스캔은 끝까지 돌지만 LLM 판정(judge)과
# 시민용 쉬운 한국어 변환을 건너뛴다. 등급·발견·상향 조건은 static 경로라 영향받지 않는다.
GEMINI_API_KEY=

# 포트가 점유된 경우에만 덮어쓴다. 데모 진입점은 8080, API는 8000이 기본이다.
# WEB_PORT=8080
# API_PORT=8000
